{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "version": "1.39.0",
  "default_locale": "en",
  "description": "__MSG_extDesc__",
  "permissions": [
    "storage",
    "notifications",
    "alarms",
    "offscreen",
    "identity"
  ],
  "host_permissions": [
    "https://*.tradingview.com/chart/*",
    "https://hsoaqylcrmspyckkndab.supabase.co/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.tradingview.com/chart/*"
      ],
      "js": [
        "inject.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://*.tradingview.com/chart/*"
      ],
      "js": [
        "shared.js",
        "content.js"
      ],
      "css": [
        "news.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Red News – Economic Calendar for TradingView",
    "default_icon": {
      "16": "icons/N16.png",
      "48": "icons/news48.png",
      "128": "icons/news128.png"
    }
  },
  "icons": {
    "16": "icons/N16.png",
    "48": "icons/news48.png",
    "128": "icons/news128.png"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "sounds/*",
        "_locales/*/messages.json"
      ],
      "matches": [
        "https://*.tradingview.com/*"
      ]
    }
  ]
}
