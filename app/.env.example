# Public origin of this site — canonical URLs, hreflang, sitemap and OG links derive from it.
# Subdomain first, rednews.app later: changing this value is the whole migration.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Red News API (server/). Defaults to the Render deployment when unset.
NEXT_PUBLIC_API_URL=https://rednews-g6ly.onrender.com/api/v1

# Only the production domain should be crawlable; leave unset on previews and the beta subdomain.
# NEXT_PUBLIC_ALLOW_INDEXING=true

# Supabase — same project the extension uses (auth, entitlements, account Edge Functions).
# The publishable/anon key is safe to expose client-side (RLS-protected), not a secret.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_your-key

# Paddle client-side tokens (Paddle dashboard → Developer Tools → Authentication → Client-side
# tokens), used by /checkout to open the payment overlay. Not secrets — meant to run in the
# browser, same class as a Stripe publishable key. Both are needed since the page picks one at
# runtime from the `env` query param the paddle-checkout Edge Function sets.
NEXT_PUBLIC_PADDLE_SANDBOX_TOKEN=test_your-sandbox-token
NEXT_PUBLIC_PADDLE_PRODUCTION_TOKEN=live_your-production-token
